// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model TankSite {
 id String @id @default(cuid())
 name String
 facilityNumber String
 operator String
 jurisdiction String
 address String
 reviewAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseStorageTank_tankSiteId StorageTank[] @relation("StorageTank_tankSiteId")
 inverseTankComponent_tankSiteId TankComponent[] @relation("TankComponent_tankSiteId")
 inverseLeakTest_tankSiteId LeakTest[] @relation("LeakTest_tankSiteId")
 inverseWalkthrough_tankSiteId Walkthrough[] @relation("Walkthrough_tankSiteId")
 inverseTankRepair_tankSiteId TankRepair[] @relation("TankRepair_tankSiteId")
 inverseInventoryReading_tankSiteId InventoryReading[] @relation("InventoryReading_tankSiteId")
 inverseOperatorTraining_tankSiteId OperatorTraining[] @relation("OperatorTraining_tankSiteId")
 inverseIncidentNotice_tankSiteId IncidentNotice[] @relation("IncidentNotice_tankSiteId")
 inverseOperationalTask_tankSiteId OperationalTask[] @relation("OperationalTask_tankSiteId")
 inverseRuleVersion_tankSiteId RuleVersion[] @relation("RuleVersion_tankSiteId")
 inverseDocumentRequirement_tankSiteId DocumentRequirement[] @relation("DocumentRequirement_tankSiteId")
}

model StorageTank {
 id String @id @default(cuid())
 name String
 tankNumber String
 product String
 capacityLiters Float
 installedAt DateTime
 construction String
 status String @default("Draft")
 tankSiteId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([tankSiteId])
 linkedTankSiteId TankSite @relation("StorageTank_tankSiteId", fields: [tankSiteId], references: [id], onDelete: Restrict)
 inverseTankComponent_storageTankId TankComponent[] @relation("TankComponent_storageTankId")
 inverseLeakTest_storageTankId LeakTest[] @relation("LeakTest_storageTankId")
 inverseTankRepair_storageTankId TankRepair[] @relation("TankRepair_storageTankId")
 inverseInventoryReading_storageTankId InventoryReading[] @relation("InventoryReading_storageTankId")
 inverseIncidentNotice_storageTankId IncidentNotice[] @relation("IncidentNotice_storageTankId")
}

